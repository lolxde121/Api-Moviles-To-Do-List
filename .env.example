# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - API TO-DO LIST MULTIUSUARIO
# ==============================================================================

# Entorno de ejecución: development | production | testing
ENVIRONMENT=development

# Configuración del servidor
PROJECT_NAME="To-Do List API"
API_V1_PREFIX="/api/v1"
DEBUG=True

# Seguridad y Autenticación JWT
# Generar una clave secreta segura con: openssl rand -hex 32
SECRET_KEY=cambiar_esta_clave_por_una_cadena_aleatoria_super_segura_de_minimo_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de Datos
# Opción 1: SQLite (por defecto, ideal para desarrollo local y pruebas)
DATABASE_URL=sqlite:///./todos.db

# Opción 2: PostgreSQL (recomendado para producción / AWS RDS)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/todo_db

# Configuración de CORS (Orígenes permitidos separados por comas)
# Para producción, reemplace con los dominios permitidos (e.g. https://mi-app.com,https://admin.mi-app.com)
ALLOWED_ORIGINS=["*"]
